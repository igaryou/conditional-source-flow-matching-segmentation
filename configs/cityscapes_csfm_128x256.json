{
  "dataset": {
    "name": "Cityscapes",
    "data_root": "~/datasets/cityscapes",
    "mode": "fine",
    "train_split": "train",
    "eval_split": "val",
    "num_classes": 20,
    "image_size": [
      128,
      256
    ],
    "num_workers": 4
  },
  "training": {
    "result_dir": "outputs/csfm_cityscapes_128x256",
    "epochs": 150,
    "batch_size": 4,
    "amp": true,
    "amp_dtype": "bf16",
    "use_checkpoint": true,
    "resume": null,
    "resume_mode": "full",
    "resume_reset_lr": null,
    "grad_clip_norm": 1.0,
    "seed": 0
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 3e-05,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "warmup_cosine",
    "warmup_epochs": 10,
    "eta_min": 1e-06
  },
  "flow_matching": {
    "lam": 0.5,
    "alpha_1": 100.0,
    "alpha_0": 10.0,
    "a": 1.0,
    "b": 0.0,
    "sampler": "euler",
    "z0_mode": "generator",
    "z0_noise_std": 0.5,
    "var_weight": 5.0,
    "align_weight": 1.0
  },
  "model": {
    "image_channels": 3,
    "fusion_channels": 128,
    "rrdb_blocks": 15,
    "rrdb_growth_channels": 32,
    "unet_base_channels": 128,
    "unet_channel_mults": [
      1,
      2,
      4,
      8
    ],
    "num_res_blocks": 3,
    "time_emb_dim": 256,
    "attn_levels": [
      3,
      4
    ],
    "dropout": 0.0,
    "num_heads": 4
  },
  "source_generator": {
    "image_channels": 3,
    "fusion_channels": 128,
    "rrdb_blocks": 10,
    "rrdb_growth_channels": 32,
    "source_base_channels": 96,
    "source_channel_mults": [
      1,
      4,
      8
    ],
    "num_res_blocks": 3,
    "attn_levels": [
      3
    ],
    "dropout": 0.0,
    "num_heads": 4,
    "fixed_std": 1.0,
    "logvar_min": -6.0,
    "logvar_max": 3.0
  },
  "evaluation": {
    "ckpt_path": null,
    "save_dir": "results/csfm_cityscapes_128x256",
    "split": "val",
    "batch_size": 4,
    "num_steps": 50,
    "num_visualize": 16,
    "num_snap_points": 5,
    "decode_z0": false,
    "sample_seed": 0,
    "limit_batches": null
  },
  "wandb": {
    "use_wandb": false,
    "project": "conditional-source-flow-matching-segmentation",
    "name": null,
    "run_id": null,
    "resume": "allow"
  }
}
